# Radiant Vista - Apache configuration (copied to dist/ by build.mjs)
# The site is fully static: every route is a pre-rendered <route>/index.html.
# There is no SPA fallback; anything that is not a real file is a real 404.

Options -Indexes
DirectoryIndex index.html
# We add trailing slashes ourselves (below) so that http/www/slash fixes happen in ONE redirect.
DirectorySlash Off
ErrorDocument 404 /404.html

# Character set for every text response
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .mjs .json .xml .txt .svg
AddType "text/html; charset=utf-8" .html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Renamed images: old URL -> new URL on the canonical origin, in ONE 301 from any scheme/host.
  #    No file-existence conditions, so these fire even while the old files are still on the server.
  #    (Generated at build time from src/data/image-renames.json.)
  RewriteRule ^images/2_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-woven-pendant-lights.webp [R=301,L]
  RewriteRule ^images/ChatGPT\ Image\ Oct\ 11,\ 2026,\ 03_02_41\ PM_result\.webp$ https://hotelradiantvista.com/images/hotel-lobby-atrium-radiant-vista.webp [R=301,L]
  RewriteRule ^images/abt1\.jpg$ https://hotelradiantvista.com/images/radiant-vista-hotel-exterior-night.jpg [R=301,L]
  RewriteRule ^images/bar/Aerial\ Rooftop\ Terrace\ Dining\ Scene_result\.webp$ https://hotelradiantvista.com/images/breeze-point-aerial-rooftop-dining.webp [R=301,L]
  RewriteRule ^images/bar/ChatGPT\ Image\ Oct\ 11,\ 2026,\ 03_02_47\ PM_result\.webp$ https://hotelradiantvista.com/images/breeze-point-open-air-rooftop-terrace.webp [R=301,L]
  RewriteRule ^images/bar/Gourmet\ Indian\ Feast\ Overhead_result\.webp$ https://hotelradiantvista.com/images/breeze-point-gourmet-indian-feast-overhead.webp [R=301,L]
  RewriteRule ^images/brick\.png$ https://hotelradiantvista.com/images/brick-and-brew-logo.png [R=301,L]
  RewriteRule ^images/c3_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-arched-dining-room.webp [R=301,L]
  RewriteRule ^images/c5_result\.webp$ https://hotelradiantvista.com/images/reception-front-desk-radiant-vista.webp [R=301,L]
  RewriteRule ^images/classic1_result\.webp$ https://hotelradiantvista.com/images/classic-room-bed-radiant-vista.webp [R=301,L]
  RewriteRule ^images/dining/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_24_07\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-woven-lantern-dining.webp [R=301,L]
  RewriteRule ^images/dining/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_24_14\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-contemporary-dining-hall.webp [R=301,L]
  RewriteRule ^images/dining/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_17_28\ PM_result\.webp$ https://hotelradiantvista.com/images/breeze-point-rooftop-bar-counter.webp [R=301,L]
  RewriteRule ^images/dining/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_17_45\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-restobar-overview.webp [R=301,L]
  RewriteRule ^images/g3_result\.webp$ https://hotelradiantvista.com/images/gala-vista-banquet-hall-round-tables.webp [R=301,L]
