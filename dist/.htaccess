  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_24_10\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-group-dining-table.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_24_14\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-contemporary-dining-hall.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_17_28\ PM_result\.webp$ https://hotelradiantvista.com/images/breeze-point-rooftop-bar-counter.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_17_35\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-arched-booth-seating.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_17_45\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-restobar-overview.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_17_48\ PM_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-twilight-seating.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_35_40\ PM_result\.webp$ https://hotelradiantvista.com/images/gala-vista-banquet-hall-stage.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_35_54\ PM_result\.webp$ https://hotelradiantvista.com/images/gala-vista-banquet-round-table-setup.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 11,\ 2026,\ 03_02_47\ PM_result\.webp$ https://hotelradiantvista.com/images/breeze-point-open-air-rooftop-terrace.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 11,\ 2026,\ 03_10_05\ PM_result\.webp$ https://hotelradiantvista.com/images/reception-lobby-lounge-radiant-vista.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 11,\ 2026,\ 03_19_42\ PM_result\.webp$ https://hotelradiantvista.com/images/suite-living-area-lounge-radiant-vista.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 11,\ 2026,\ 03_20_44\ PM_result\.webp$ https://hotelradiantvista.com/images/gourmet-indian-feast-radiant-vista.webp [R=301,L]
  RewriteRule ^images/gallery/ChatGPT\ Image\ Oct\ 11,\ 2026,\ 03_24_50\ PM_result\.webp$ https://hotelradiantvista.com/images/hotel-facade-night-radiant-vista-hubballi.webp [R=301,L]
  RewriteRule ^images/gallery/abt_result\.webp$ https://hotelradiantvista.com/images/brick-and-brew-restaurant-dining-space.webp [R=301,L]
  RewriteRule ^images/gallery/g2_result\.webp$ https://hotelradiantvista.com/images/breeze-point-illuminated-spirits-bar.webp [R=301,L]
  RewriteRule ^images/gallery/g4_result\.webp$ https://hotelradiantvista.com/images/guest-room-bath-amenities-radiant-vista.webp [R=301,L]
  RewriteRule ^images/hall/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_35_40\ PM_result\.webp$ https://hotelradiantvista.com/images/gala-vista-banquet-hall-stage.webp [R=301,L]
  RewriteRule ^images/hall/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_35_48\ PM_result\.webp$ https://hotelradiantvista.com/images/gala-vista-conference-hall-theatre-seating.webp [R=301,L]
  RewriteRule ^images/hall/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 03_35_54\ PM_result\.webp$ https://hotelradiantvista.com/images/gala-vista-banquet-round-table-setup.webp [R=301,L]
  RewriteRule ^images/premium_result\.webp$ https://hotelradiantvista.com/images/premium-room-radiant-vista.webp [R=301,L]
  RewriteRule ^images/radiant-vista-about\.webp$ https://hotelradiantvista.com/images/radiant-vista-hotel-exterior-day-hubballi.webp [R=301,L]
  RewriteRule ^images/roomimage/classic/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 12_35_43\ PM_result\.webp$ https://hotelradiantvista.com/images/classic-room-radiant-vista-hubballi-1.webp [R=301,L]
  RewriteRule ^images/roomimage/classic/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 12_36_03\ PM_result\.webp$ https://hotelradiantvista.com/images/classic-room-radiant-vista-hubballi-2.webp [R=301,L]
  RewriteRule ^images/roomimage/classic/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 12_36_08\ PM_result\.webp$ https://hotelradiantvista.com/images/classic-room-radiant-vista-hubballi-3.webp [R=301,L]
  RewriteRule ^images/roomimage/premium/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_06_58\ PM_result\.webp$ https://hotelradiantvista.com/images/premium-room-radiant-vista-hubballi-1.webp [R=301,L]
  RewriteRule ^images/roomimage/premium/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_07_00\ PM_result\.webp$ https://hotelradiantvista.com/images/premium-room-radiant-vista-hubballi-2.webp [R=301,L]
  RewriteRule ^images/roomimage/premium/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_07_03\ PM_result\.webp$ https://hotelradiantvista.com/images/premium-room-radiant-vista-hubballi-3.webp [R=301,L]
  RewriteRule ^images/roomimage/premium/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 02_07_05\ PM_result\.webp$ https://hotelradiantvista.com/images/premium-room-radiant-vista-hubballi-4.webp [R=301,L]
  RewriteRule ^images/roomimage/suit/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 12_15_08\ PM_result\.webp$ https://hotelradiantvista.com/images/suite-radiant-vista-hubballi-1.webp [R=301,L]
  RewriteRule ^images/roomimage/suit/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 12_15_11\ PM_result\.webp$ https://hotelradiantvista.com/images/suite-radiant-vista-hubballi-2.webp [R=301,L]
  RewriteRule ^images/roomimage/suit/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 12_15_13\ PM_result\.webp$ https://hotelradiantvista.com/images/suite-radiant-vista-hubballi-3.webp [R=301,L]
  RewriteRule ^images/roomimage/suit/ChatGPT\ Image\ Oct\ 10,\ 2026,\ 12_15_15\ PM_result\.webp$ https://hotelradiantvista.com/images/suite-radiant-vista-hubballi-4.webp [R=301,L]
  RewriteRule ^images/suite1_result\.webp$ https://hotelradiantvista.com/images/suite-bedroom-radiant-vista.webp [R=301,L]
  RewriteRule ^images/suite_result\.webp$ https://hotelradiantvista.com/images/suite-living-dining-area-radiant-vista.webp [R=301,L]

  # 1. /index.html or /<dir>/index.html -> the directory URL on the canonical origin
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ https://hotelradiantvista.com/%1 [R=301,L,NE]

  # 2. A real directory requested without its trailing slash (/rooms) -> https://hotelradiantvista.com/rooms/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ https://hotelradiantvista.com/$1/ [R=301,L]

  # 3. www and/or http -> https://hotelradiantvista.com (single hop, path and query kept)
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://hotelradiantvista.com/$1 [R=301,L]
</IfModule>

# Security & Cache-Control Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"

  # Content-Security-Policy: same-origin assets, Google Maps embed, ResAvenue booking engine
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://hotelradiantvista.com https://www.transparenttextures.com https://*.googleapis.com https://*.gstatic.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src 'self' https://www.google.com https://bookings.resavenue.com; connect-src 'self' https://bookings.resavenue.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; form-action 'self'; base-uri 'self'; object-src 'none'"

  # Default for static files: 30 days
  <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|avif|js|css|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Content-hashed build output (/assets/app-xxxxxxxx.js, styles-xxxxxxxx.css, fonts): 1 year, immutable
  <FilesMatch "-[0-9a-f]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML, XML and text must always revalidate so content and SEO changes go live immediately
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Images under /images/ (responsive variants written by the build): 1 year
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/images/#">
    Header set Cache-Control "public, max-age=31536000"
  </If>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# HTTP/2 cannot be enabled from .htaccess ("Protocols" is server/vhost-only). See SEO-TODO.md.
